# PostgreSQL connection string (Render Postgres, Neon or Supabase all work)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/picklelive?schema=public"
# Admin login (single admin account, credentials checked with bcrypt)
ADMIN_EMAIL="admin@picklelive.local"
ADMIN_PASSWORD="changeme123"
# Shared referee login (one login for all referees). The admin can also set it in Settings.
REF_USERNAME="referee"
REF_PASSWORD="ref12345"
# Long random string used to sign the admin JWT cookie
JWT_SECRET="replace-with-a-long-random-string"
# Public origin of the app (used for CORS + share links). Leave empty locally.
APP_ORIGIN="http://localhost:5173"
PORT=3000
NODE_ENV=development
