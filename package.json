{
  "name": "picklelive",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time pickleball team tournament & live scoring",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "prisma generate && vite build && node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.2.0",
    "@dnd-kit/sortable": "9.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource/barlow-condensed": "5.1.0",
    "@prisma/client": "5.22.0",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-dropdown-menu": "2.1.2",
    "@radix-ui/react-label": "2.1.0",
    "@radix-ui/react-select": "2.1.2",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-switch": "1.1.1",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.4",
    "@tanstack/react-query": "5.61.0",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "compression": "1.7.5",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "framer-motion": "11.11.17",
    "helmet": "8.0.0",
    "idb-keyval": "6.2.1",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.460.0",
    "qrcode.react": "4.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "sonner": "1.7.0",
    "tailwind-merge": "2.5.4",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.63.0",
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cookie-parser": "1.4.7",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "esbuild": "0.24.0",
    "eslint": "9.15.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.12.0",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
